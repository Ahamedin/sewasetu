# Copy to a protected, uncommitted environment file and replace placeholders.
SEWASETU_DB_PASSWORD=<generate-a-new-database-password>
SEWASETU_FLASK_SECRET_KEY=<generate-a-long-random-secret>
SEWASETU_ADMIN_USERNAME=admin
SEWASETU_ADMIN_PASSWORD_HASH=<generate-a-werkzeug-password-hash>
SEWASETU_RESET_CODE_PEPPER=<generate-a-long-random-reset-code-pepper>
SEWASETU_REDIS_URL=redis://redis:6379/0

# Local development defaults; set secure cookies and the production hostname
# only behind an approved HTTPS reverse proxy.
SEWASETU_SESSION_COOKIE_SECURE=false
SEWASETU_SESSION_COOKIE_HTTPONLY=true
SEWASETU_SESSION_COOKIE_SAMESITE=Lax
SEWASETU_ALLOWED_HOSTS=localhost,127.0.0.1
SEWASETU_TRUSTED_PROXY_COUNT=0
